# ============================================================
# .env.example — 변화탐지 플랫폼 환경 변수 (개발용 기본값)
#
# 사용법: cp .env.example .env  → 값 수정
# 운영 환경(.env.prod)은 이정표 6에서 별도 분리.
# ============================================================

# ---- Compose / 개발 웹 진입점 ----
# 개발 stack 은 배포 stack(nbm_update, 0.0.0.0:18200)과 동시에 뜰 수 있도록
# 별도 project name 과 18210 host publish 를 사용한다.
COMPOSE_PROJECT_NAME=nbm-update-discovery
NBM_DEV_HOST_BIND=0.0.0.0
NBM_DEV_WEB_PORT=18210

# ---- Postgres + PostGIS ----
POSTGRES_USER=nbm
POSTGRES_PASSWORD=nbm_dev_change_me
POSTGRES_DB=nbm
POSTGRES_HOST=postgres

# ---- Backend ----
DATABASE_URL=postgresql+psycopg2://nbm:nbm_dev_change_me@postgres:5432/nbm
JWT_SECRET=__replace_in_production__
SECRET_KEY=__replace_in_production__

# ---- Frontend ----
# 같은 origin 의 Vite/nginx proxy 를 통해 backend 로 전달된다.
VITE_API_BASE_URL=/api/v1
# 운영에서는 false. 프론트 단독 화면 검증이 필요할 때만 true 로 바꾼다.
VITE_USE_MOCK=false

# ---- Redis ----
REDIS_HOST=redis
REDIS_URL=redis://redis:6379/0

# ---- 실제 변화탐지 알고리즘 워커 ----
# FastAPI 신규 작업 큐. engine 으로 두면 별도 GPU 워커가 실제 알고리즘을 수행한다.
CHANGE_DETECTION_QUEUE=engine
CHANGE_DETECTION_VISIBILITY_TIMEOUT_S=259200
CHANGE_DETECTION_ENGINE_MODE=algorithm
CHANGE_DETECTION_ALGORITHM_ROOT=/engines/pm
CHANGE_DETECTION_WORKSPACE_ROOT=/data/storage/exports
CHANGE_DETECTION_SHM_SIZE=16gb
CHANGE_DETECTION_PREPARE_MODE=sheet_12cm
CHANGE_DETECTION_TARGET_GSD_M=0.12
CHANGE_DETECTION_SHEET_BUFFER_M=32
CHANGE_DETECTION_RESAMPLING=cubic
CHANGE_DETECTION_BATCH_SIZE=1

# ---- TiTiler ----
# 브라우저는 /titiler 프록시 경로를 사용한다. TiTiler host port 는 publish 하지 않는다.

# ---- Storage (이정표 4부터 사용) ----
STORAGE_ROOT=/data/storage

# ---- 호스트 데이터 경로 ----
# 컨테이너 내부 /data/orthomosaic 으로 마운트된다.
# 웹에서 업로드한 정사영상도 이 폴더에 저장된다.
HOST_ORTHOMOSAIC_DIR=./data/orthomosaic

# 컨테이너 내부 /data/storage/exports 으로 마운트된다.
# 변화탐지 결과물은 task_id 별 하위 디렉토리로 저장된다.
HOST_EXPORT_OUTPUT_DIR=./exports

# 컨테이너 내부 /data/dem 으로 마운트된다.
# 3D DXF 생성 시 도엽별 DEM .img 를 찾는 경로다.
HOST_DEM_DIR=./data/dem

# ---- VWorld 오프라인 베이스맵 타일 ----
# 호스트의 vworld_tiles 디렉토리 (구조: {z}/{x}/{y}.jpg, EPSG:3857 XYZ)
# 미설정 시 ./data/vworld_tiles 폴백.
HOST_VWORLD_TILES_DIR=./data/vworld_tiles
