# ============================================================
# frontend/.env.example
#
# 사용법:
#   cp frontend/.env.example frontend/.env
#   docker compose restart frontend
#
# VITE_API_BASE_URL 미설정/공백 시 frontend 는 mock 모드 (정적 JSON fetch).
# 설정 시 backend 모드 — 모든 read 호출이 백엔드로 swap.
# ============================================================

# 1차 출시 backend 모드 — Vite/nginx 프록시로 same-origin:
# 개발 브라우저 진입점은 http://127.0.0.1:18210, 배포 진입점은 http://배포PC_IP:18200.
VITE_API_BASE_URL=/api/v1

# 내부망 배포에서도 브라우저는 http://배포PC_내부IP:18200/api/v1 로
# 같은 origin 프록시를 통해 접근한다. Docker 서비스명은 브라우저용 값에 쓰지 않는다.

# Mock 모드로 되돌리려면:
# VITE_API_BASE_URL=
